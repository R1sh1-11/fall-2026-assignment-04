erDiagram
    %% USERS exists in 001_initial_schema
    USERS {
        int id PK
        string email UK
        string name
        timestamp created_at
    }

    BORROWERS {
        int id PK
        int user_id FK, UK
        string membership_number UK
        string phone
        timestamp joined_at
    }

    AUTHORS {
        int id PK
        string name
        text bio
    }

    GENRES {
        int id PK
        string name UK
    }

    BOOKS {
        int id PK
        string title
        string isbn UK
        int published_year
        int genre_id FK
    }

    BOOK_AUTHORS {
        int book_id PK, FK
        int author_id PK, FK
    }

    LOANS {
        int id PK
        int borrower_id FK
        int book_id FK
        timestamp loaned_at
        timestamp due_at
        timestamp returned_at
    }

    USERS ||--o| BORROWERS : "has"
    GENRES ||--o{ BOOKS : "contains"
    BOOKS ||--o{ BOOK_AUTHORS : "has"
    AUTHORS ||--o{ BOOK_AUTHORS : "writes"
    BORROWERS ||--o{ LOANS : "borrows"
    BOOKS ||--o{ LOANS : "loaned in"
